.dining-orders { padding:34rpx 28rpx; }
.dining-order-card { margin-top:24rpx; padding:26rpx; border:1rpx solid var(--line); border-radius:22rpx; background:#fffdf8; }
.order-top,.order-line,.order-total { display:flex; align-items:center; justify-content:space-between; }
.order-top > text:first-child { font-weight:650; }
.fulfillment { padding:8rpx 12rpx; border-radius:16rpx; color:#327969; background:#e5f1ec; font-size:19rpx; }
.fulfillment.EXCEPTION { color:#a64737; background:#fae5df; }
.order-line { margin-top:20rpx; color:#6e7973; font-size:23rpx; }
.order-total { margin-top:22rpx; padding-top:18rpx; border-top:1rpx solid var(--line); }
.order-total text:last-child { color:#2f6e62; font-size:30rpx; font-weight:650; }
.order-no { display:block; margin-top:16rpx; color:#9aa09d; font-size:17rpx; word-break:break-all; }
.exception-note { margin-top:16rpx; padding:16rpx; border-radius:12rpx; color:#965646; background:#f8e9e2; font-size:20rpx; line-height:1.5; }
