.tickets-page { padding: 30rpx 30rpx 150rpx; }
.ticket-intro { min-height: 220rpx; padding: 28rpx; display: grid; grid-template-columns: 1fr 220rpx; gap: 20rpx; align-items: center; border: 1rpx solid var(--line); border-radius: 28rpx; background: #fffdf8; }
.ticket-intro text { display: block; }
.ticket-intro .en { color: #9c8358; font-size: 18rpx; letter-spacing: 3rpx; }
.ticket-intro .title { margin: 12rpx 0; font: 600 38rpx "STSong",serif; }
.ticket-intro .desc { color: #78817d; font-size: 22rpx; line-height: 1.5; }
.ticket-intro image { width: 220rpx; height: 165rpx; border-radius: 20rpx; }
.tips { margin-top: 20rpx; padding: 22rpx; border-radius: 18rpx; color: #6f6759; background: #eee7d6; font-size: 22rpx; line-height: 1.6; }
.form-section { margin-top: 36rpx; }
.step-head { display: flex; align-items: center; gap: 18rpx; margin-bottom: 18rpx; }
.step-head > text { color: #b9a47a; font: 34rpx Georgia,serif; }
.step-head view text { display: block; font-size: 28rpx; font-weight: 600; }
.step-head view text + text { margin-top: 5rpx; color: #979d9a; font-size: 20rpx; font-weight: 400; }
.dates { width: 100%; white-space: nowrap; }
.dates button { width: 142rpx; height: 110rpx; margin-right: 14rpx; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #ded8ca; border-radius: 18rpx; color: #69736e; background: #fffdf8; }
.dates button text { display: block; font-size: 22rpx; }
.dates button text + text { margin-top: 9rpx; font-size: 24rpx; font-weight: 650; }
.dates button.active { border-color: var(--green); color: #fff; background: var(--green); }
.slots { display: grid; gap: 14rpx; }
.slots button { min-height: 118rpx; padding: 18rpx 24rpx; display: grid; grid-template-columns: auto 1fr auto; gap: 20rpx; align-items: center; text-align: left; border: 1rpx solid #ded8ca; border-radius: 20rpx; color: #35423d; background: #fffdf8; }
.slots button.active { border: 3rpx solid var(--green); background: #f2f8f5; }
.radio { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #b8c0bd; border-radius: 50%; }
.active .radio { border-color: var(--green); }
.active .radio text { width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--green); }
.slot-name,.slot-time { display: block; }
.slot-name { font-size: 27rpx; font-weight: 600; }
.slot-time { margin-top: 8rpx; color: #818a86; font-size: 20rpx; }
.price { color: #327969; font-size: 30rpx; font-weight: 650; }
.guest { min-height: 100rpx; padding: 16rpx 4rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); }
.guest view:first-child text { display: block; font-size: 27rpx; font-weight: 600; }
.guest view:first-child text + text { margin-top: 7rpx; color: #929995; font-size: 20rpx; font-weight: 400; }
.counter { display: flex; align-items: center; gap: 24rpx; }
.counter button { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #aac6bd; border-radius: 50%; color: #327969; background: #fff; font-size: 30rpx; }
.counter text { min-width: 28rpx; text-align: center; font-weight: 650; }
.bottom-bar { min-height: 126rpx; position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; padding: 17rpx 30rpx calc(17rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid var(--line); background: rgba(255,255,255,.98); }
.bottom-bar > view > text:first-child { margin-right: 12rpx; color: #78817d; font-size: 22rpx; }
.bottom-bar .total { color: #2f6e62; font-size: 44rpx; font-weight: 700; }
.bottom-bar .total text { font-size: 24rpx; }
.bottom-bar > button { width: 340rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 46rpx; color: white; background: var(--green); font-size: 29rpx; font-weight: 650; }
