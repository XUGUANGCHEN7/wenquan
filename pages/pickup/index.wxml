<view class="page pickup-page">
  <block wx:if="{{orders.length}}">
    <view class="hero {{orders[0].state}}">
      <view class="state-pill {{orders[0].state}}">{{orders[0].stateText}}</view>
      <text class="hero-label">PICKUP NUMBER · 取餐号</text>
      <text class="hero-no">{{orders[0].no}}</text>
      <view class="window-line {{orders[0].fulfillment === 'delivery' ? 'delivery' : ''}}">
        {{orders[0].fulfillment === 'delivery' ? '将送至 ' + orders[0].room + ' 私汤房 · 服务员配送到房' : '请到 ' + orders[0].window + ' 取餐'}}
      </view>
      <view class="hero-meta">
        <text>{{orders[0].merchantName}}</text>
        <text>{{orders[0].qty}} 件 · ¥{{orders[0].total}}</text>
      </view>
      <button wx:if="{{orders[0].state === 'ready'}}" class="hero-done" data-id="{{orders[0].id}}" bindtap="markDone">我已取到餐</button>
    </view>

    <view wx:if="{{orders.length > 1}}" class="rest-head">
      <text>其他订单</text>
      <text>共 {{orders.length - 1}} 单</text>
    </view>
    <view class="rest-list">
      <view wx:for="{{orders}}" wx:for-index="idx" wx:key="id">
        <view wx:if="{{idx > 0}}" class="rest-row {{item.state}}">
          <view class="rest-left">
            <text class="rest-no">{{item.no}}</text>
            <text class="rest-info">{{item.merchantName}} · {{item.fulfillment === 'delivery' ? '送至' + item.room + '房' : item.window}}</text>
          </view>
          <view class="rest-right">
            <text class="rest-state {{item.state}}">{{item.stateText}}</text>
            <button wx:if="{{item.state === 'ready'}}" class="mini-done" data-id="{{item.id}}" bindtap="markDone">取餐</button>
          </view>
        </view>
      </view>
    </view>
    <view class="list-end"><text>— 全部取完后提示将自动消失 —</text></view>
  </block>

  <view wx:else class="empty-block">
    <text class="empty-title">所有餐品已取完</text>
    <text class="empty-desc">下次点餐后，各窗口的取餐提示会显示在这里</text>
    <button class="home-btn" bindtap="goHome">返回首页</button>
  </view>
  <view class="safe-bottom" />
</view>
