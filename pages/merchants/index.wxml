<view class="page merchants-page">
  <view class="heading">
    <view><text>SHUNAN DINING</text><text>园内点餐</text></view>
    <text class="order">订单</text>
  </view>
  <view class="location">
    <text>⌂</text><text>送至 <text>请选择取餐位置 / 私汤房</text></text><text>›</text>
  </view>
  <view class="ordering">
    <scroll-view class="merchant-side" scroll-y>
      <button wx:for="{{merchants}}" wx:key="id" class="{{merchantIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectMerchant">
        <text>{{item.name}}</text><text>{{item.desc}}</text>
      </button>
    </scroll-view>
    <scroll-view class="dishes" scroll-y>
      <view class="dish-head"><text>{{merchants[merchantIndex].name}}</text><text>{{merchants[merchantIndex].meta}}</text></view>
      <view wx:for="{{products}}" wx:key="name" class="product">
        <image mode="aspectFill" src="{{item.image}}" />
        <view class="product-info">
          <text>{{item.name}}</text>
          <text>{{item.desc}}</text>
          <text>月售 {{item.sold}}</text>
          <view class="product-bottom">
            <text><text>¥</text>{{item.price}}</text>
            <view class="counter">
              <button wx:if="{{counts[index] > 0}}" data-index="{{index}}" data-delta="-1" catchtap="changeCount">−</button>
              <text wx:if="{{counts[index] > 0}}">{{counts[index]}}</text>
              <button class="plus" data-index="{{index}}" data-delta="1" catchtap="changeCount">＋</button>
            </view>
          </view>
        </view>
      </view>
      <view class="list-bottom-space" />
    </scroll-view>
  </view>
  <view class="cart">
    <view class="bag">袋<text wx:if="{{quantity}}">{{quantity}}</text></view>
    <view><text>¥{{total}}</text><text>{{cartName}} · 窗口自取</text></view>
    <button class="{{quantity ? '' : 'disabled'}}" bindtap="checkout">去结算</button>
  </view>
</view>
