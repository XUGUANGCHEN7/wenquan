.do-page { padding: 24rpx 30rpx 60rpx; }

/* 空态 */
.empty-card { margin-top: 100rpx; padding: 80rpx 44rpx; border: 1rpx solid var(--line); border-radius: 32rpx; background: #fffdf8; text-align: center; }
.empty-title { display: block; font: 600 34rpx "STSong", serif; color: #26342f; }
.empty-desc { display: block; margin-top: 16rpx; color: #8a938f; font-size: 22rpx; line-height: 1.7; }
.empty-btn { margin-top: 40rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 46rpx; color: #fff; background: var(--green); font-size: 30rpx; font-weight: 600; }

/* 主取餐卡 */
.now-card { position: relative; overflow: hidden; padding: 34rpx 34rpx 30rpx; border-radius: 36rpx; color: #fff; background: linear-gradient(160deg, #49a996 0%, #3e8e7e 42%, #2f5d54 100%); box-shadow: 0 18rpx 40rpx rgba(47, 93, 84, .22); }
.now-card::after { content: ""; position: absolute; top: -120rpx; right: -90rpx; width: 320rpx; height: 320rpx; border-radius: 50%; background: rgba(255, 255, 255, .08); }
.now-card.done { opacity: .7; }

.now-head { position: relative; display: flex; align-items: center; justify-content: space-between; }
.now-state { padding: 8rpx 24rpx; border-radius: 999rpx; font-size: 22rpx; letter-spacing: 2rpx; color: #d9e8e2; background: rgba(255, 255, 255, .18); }
.now-state.ready { color: #2f5d54; background: #ffd34d; font-weight: 650; }
.now-state.done { color: #2f5d54; background: rgba(255, 255, 255, .7); }
.now-merchant { color: rgba(255, 255, 255, .72); font-size: 22rpx; letter-spacing: 1rpx; }

.now-label { position: relative; display: block; margin-top: 40rpx; text-align: center; color: rgba(255, 255, 255, .6); font-size: 18rpx; letter-spacing: 5rpx; }
.now-no { position: relative; display: block; margin: 6rpx 0 26rpx; text-align: center; font: 700 152rpx/1.1 Georgia, "STSong", serif; letter-spacing: 6rpx; text-shadow: 0 6rpx 18rpx rgba(0, 0, 0, .12); }

.now-window { position: relative; margin: 0 auto; width: fit-content; max-width: 100%; padding: 18rpx 40rpx; border-radius: 999rpx; color: #2f5d54; background: #fff; font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.now-window.delivery { background: #f3d9a4; }

.now-items { position: relative; margin-top: 30rpx; padding-top: 20rpx; border-top: 1rpx dashed rgba(255, 255, 255, .28); }
.now-item { min-height: 56rpx; display: flex; align-items: center; justify-content: space-between; color: rgba(255, 255, 255, .86); font-size: 24rpx; }
.now-item text:last-child { color: rgba(255, 255, 255, .66); font-size: 22rpx; }

.now-foot { position: relative; margin-top: 12rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(255, 255, 255, .16); display: flex; align-items: baseline; justify-content: space-between; font-size: 22rpx; color: rgba(255, 255, 255, .7); }
.now-total { font-size: 36rpx; font-weight: 700; color: #ffe9a8; }

.now-done { position: relative; margin-top: 30rpx; width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 48rpx; color: #2f5d54; background: #ffd34d; font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; }
.now-hint { position: relative; margin-top: 26rpx; text-align: center; color: rgba(255, 255, 255, .6); font-size: 20rpx; letter-spacing: 1rpx; }

/* 其余订单 */
.rest-head { margin: 40rpx 4rpx 0; display: flex; align-items: baseline; justify-content: space-between; }
.rest-head text:first-child { font: 600 30rpx "STSong", serif; color: #26342f; }
.rest-head text:last-child { color: #929995; font-size: 20rpx; }
.rest-list { margin-top: 8rpx; border-top: 1rpx solid var(--line); }
.rest-row { padding: 26rpx 4rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line); }
.rest-row.done { opacity: .55; }
.rest-left { flex: 1; min-width: 0; }
.rest-no { display: block; font: 700 46rpx Georgia, "STSong", serif; color: #2f5d54; letter-spacing: 2rpx; }
.rest-info { display: block; margin-top: 6rpx; color: #6d7a75; font-size: 22rpx; }
.rest-items { display: block; margin-top: 6rpx; color: #9aa39e; font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rest-right { display: flex; align-items: center; gap: 16rpx; margin-left: 20rpx; }
.rest-state { padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 20rpx; }
.rest-state.making { color: #8a6d2f; background: #f3ead5; }
.rest-state.ready { color: #fff; background: var(--green); }
.rest-state.done { color: #929995; background: #eef0ee; }
.mini-done { margin: 0; padding: 0 24rpx; height: 60rpx; display: flex; align-items: center; border: 1rpx solid var(--green); border-radius: 999rpx; color: var(--green); background: #fff; font-size: 22rpx; }
.list-end { margin-top: 36rpx; text-align: center; }
.list-end text { color: #b9bfb9; font-size: 19rpx; letter-spacing: 2rpx; }
