.do-page { padding: 30rpx 30rpx 60rpx; }
.empty-card { padding: 90rpx 40rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: #fffdf8; text-align: center; }
.empty-title { display: block; font: 600 34rpx "STSong", serif; color: #26342f; }
.empty-desc { display: block; margin-top: 16rpx; color: #8a938f; font-size: 22rpx; line-height: 1.6; }
.order-card { margin-bottom: 24rpx; padding: 26rpx 28rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: #fffdf8; }
.oc-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 1rpx dashed var(--line); }
.oc-name { font-size: 30rpx; font-weight: 650; color: #26342f; }
.oc-state { padding: 4rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; }
.oc-state.making { color: #8a6d2f; background: #f3ead5; }
.oc-state.ready { color: #fff; background: var(--green); }
.oc-state.done { color: #929995; background: #eef0ee; }
.oc-items { padding: 8rpx 0; }
.oc-item { min-height: 62rpx; display: flex; align-items: center; justify-content: space-between; }
.oc-item text:first-child { color: #4a5651; font-size: 24rpx; }
.oc-item text:last-child { color: #7d857f; font-size: 22rpx; }
.oc-foot { display: flex; align-items: center; justify-content: space-between; padding-top: 16rpx; border-top: 1rpx solid #f0ede3; }
.oc-foot text:first-child { color: #716b60; font-size: 21rpx; }
.oc-foot text:last-child { color: #2f6e62; font-size: 30rpx; font-weight: 700; }
.view-pickup { margin-top: 12rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--green); border-radius: 46rpx; color: var(--green); background: transparent; font-size: 30rpx; font-weight: 600; }
