.hero { height: 520rpx; position: relative; color: #fff; }
.hero image { width: 100%; height: 100%; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,37,30,.12), rgba(13,41,33,.72)); }
.status-space { height: calc(80rpx + env(safe-area-inset-top)); position: absolute; top: 0; }
.hero-copy { position: absolute; left: 38rpx; bottom: 54rpx; }
.eyebrow { display: block; font-size: 18rpx; letter-spacing: 5rpx; opacity: .75; }
.hero-title { display: block; margin: 18rpx 0 12rpx; white-space: pre-line; font: 500 58rpx/1.3 "STSong","Songti SC",serif; letter-spacing: 5rpx; }
.hero-desc { font-size: 24rpx; opacity: .82; }
.content { position: relative; margin-top: -28rpx; padding: 30rpx; border-radius: 32rpx 32rpx 0 0; background: var(--paper); }
.welcome { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 22rpx; }
.welcome .en { display: block; color: #a28759; font-size: 17rpx; letter-spacing: 3rpx; }
.welcome .title { display: block; margin-top: 6rpx; font: 600 36rpx "STSong","Songti SC",serif; }
.hours { color: #8a938f; font-size: 20rpx; }
.journey { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.journey-card { height: 280rpx; position: relative; padding: 28rpx 22rpx; overflow: hidden; text-align: left; border-radius: 24rpx; }
.journey-card.public { color: #2e685d; border: 1rpx solid #cfe1db; background: linear-gradient(145deg,#e1efea,#f5faf7); }
.journey-card.private { color: #715c35; border: 1rpx solid #e4d6ba; background: linear-gradient(145deg,#efe5cf,#faf7ed); }
.journey-en,.journey-title,.journey-desc,.journey-price { display: block; position: relative; z-index: 1; }
.journey-en { font-size: 17rpx; letter-spacing: 3rpx; opacity: .7; }
.journey-title { width: 220rpx; margin-top: 16rpx; font-size: 29rpx; font-weight: 650; line-height: 1.35; }
.journey-desc { margin-top: 10rpx; font-size: 20rpx; opacity: .72; }
.journey-price { position: absolute; left: 22rpx; bottom: 26rpx; font-size: 26rpx; font-weight: 650; }
.journey-icon { width: 84rpx; height: 84rpx; position: absolute; right: 16rpx; bottom: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.6); font-family: "STSong",serif; font-size: 30rpx; }
.shortcuts { margin-top: 18rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; }
.shortcuts button { height: 150rpx; padding: 18rpx 8rpx; display: flex; flex-direction: column; align-items: center; border: 1rpx solid var(--line); border-radius: 22rpx; background: rgba(255,255,255,.75); }
.shortcut-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 23rpx; font-weight: 650; }
.shortcut-icon.orange { color: #bd642f; background: #fbe7d9; }
.shortcut-icon.gold { color: #9b793b; background: #f3ead5; }
.shortcut-icon.green { color: #3d7469; background: #e1eee9; }
.shortcut-title { margin-top: 8rpx; font-size: 23rpx; font-weight: 600; }
.shortcut-desc { margin-top: 5rpx; color: #929995; font-size: 18rpx; }
.section-head { margin-inline: 0; }
.room-card { min-height: 170rpx; padding: 14rpx; display: grid; grid-template-columns: 200rpx 1fr auto; gap: 20rpx; align-items: center; border: 1rpx solid var(--line); border-radius: 24rpx; background: #fff; }
.room-card image { width: 200rpx; height: 140rpx; border-radius: 18rpx; }
.room-info text { display: block; }
.room-name { color: #4f675f; font-size: 27rpx; font-weight: 650; }
.room-desc { margin: 12rpx 0; color: #8b918e; font-size: 20rpx; line-height: 1.5; }
.room-price { color: #9a7134; font-size: 30rpx; font-weight: 700; }
.room-price text { display: inline; font-size: 18rpx; font-weight: 400; }
.arrow { color: #8a938f; font-size: 42rpx; }
